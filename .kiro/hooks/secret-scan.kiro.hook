{
  "enabled": true,
  "name": "Secret scan on save",
  "description": "When any file is saved, check it for API keys, tokens, and .env-style secrets before they can be committed.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["**/*"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A file was just saved. Scan the changed file(s) for committed secrets: high-entropy API keys, bearer/access tokens, private keys (BEGIN ... PRIVATE KEY), AWS keys (AKIA...), cloud credentials, and raw .env content (lines like KEY=secretvalue outside .env.example). Ignore placeholders in .env.example and obvious example values. If anything suspicious is found, STOP, name the file and line, and tell the user to remove it and rotate the key before committing. Never echo the secret value back. If the file is clean, say nothing further. Do not commit secrets under any circumstances."
  }
}
