# Copy to .env.local to override defaults. NEVER commit real .env files.
# The app runs on bundled mock data by default (no backend required).

# Set to "false" to hit the real FastAPI backend instead of the mock layer.
VITE_USE_MOCKS=true

# Base path for API calls. Defaults to "/api" (proxied to the backend in dev).
# VITE_API_BASE=/api
