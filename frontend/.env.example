# Copy to .env.local to override defaults. NEVER commit real .env files.

# Base URL of the Fathom FastAPI backend.
# The client calls VITE_API_URL with a 4s timeout and automatically falls back
# to bundled demo data (showing an "Offline demo data" badge) if it is
# unreachable, so the app always runs even with no backend.
VITE_API_URL=http://localhost:8000
